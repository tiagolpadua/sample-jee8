<?xml version="1.0" encoding="UTF-8"?>
<wls:weblogic-web-app
	xmlns:wls="http://xmlns.oracle.com/weblogic/weblogic-web-app"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

	<wls:context-root>sample-jee8</wls:context-root>

	<!-- Swagger pulls newer Jackson / SnakeYAML than WebLogic bundles; let the
	     WAR's copies win inside this app's classloader. -->
	<wls:container-descriptor>
		<wls:prefer-application-packages>
			<wls:package-name>com.fasterxml.jackson.*</wls:package-name>
			<wls:package-name>org.yaml.snakeyaml.*</wls:package-name>
		</wls:prefer-application-packages>
	</wls:container-descriptor>
</wls:weblogic-web-app>
